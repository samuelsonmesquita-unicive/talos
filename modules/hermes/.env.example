# Supabase (backend do Módulo Hermes)
# Project URL: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL="https://SEU-PROJECT-REF.supabase.co"

# Chave PÚBLICA (publishable / anon). Segura para o frontend: quem protege os
# dados são as policies de RLS. NUNCA coloque a service_role / secret key aqui.
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# URL base do módulo Plutos, usada para embuti-lo num <iframe> ao final do
# cadastro de um curso. Em produção não precisa definir (usa path absoluto
# /talos/plutos/ do mesmo domínio). Em dev local, aponte para a porta do
# servidor de dev do Plutos:
# VITE_PLUTOS_URL="http://localhost:3001/talos/plutos/"
